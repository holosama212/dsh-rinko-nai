{
  "name": "dsh-rinko-nai",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "YesNAI（nai.rinko.ai）出图插件：原生 rinko_nai_image 工具 + 设置页（凭据 / 默认参数 / 测试出图）",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "image-generation",
    "novelai",
    "yesnai",
    "rinko"
  ],
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.3.1"
  },
  "author": "dsh-rinko-nai contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holosama212/dsh-rinko-nai.git"
  },
  "homepage": "https://github.com/holosama212/dsh-rinko-nai#readme",
  "bugs": {
    "url": "https://github.com/holosama212/dsh-rinko-nai/issues"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "smoke": "node scripts/smoke.mjs"
  }
}
